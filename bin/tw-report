#!/usr/bin/env python
"""Entry point for tw-report.

This script sets up the Python path and runs the CLI entry point from
src/tw_report/cli/main.py (Phase 10 milestone: modularized entry point).
"""

import sys
import os

# Resolve the real path (following symlinks)
script_path = os.path.realpath(__file__)
script_dir = os.path.dirname(script_path)
project_root = os.path.dirname(script_dir)

# Add src directory to Python path BEFORE any imports
sys.path.insert(0, os.path.join(project_root, "src"))

# Now we can safely import and run the CLI entry point
if __name__ == "__main__":
    from tw_report.cli.main import main
    main()
