#!/usr/bin/env python
"""Entry point for tw-report.

This script sets up the Python path and runs the main tw-report.py script.
"""

import sys
import os

# Resolve the real path (following symlinks)
script_path = os.path.realpath(__file__)
script_dir = os.path.dirname(script_path)
project_root = os.path.dirname(script_dir)

# Add src directory to Python path BEFORE any imports
sys.path.insert(0, os.path.join(project_root, "src"))
sys.path.insert(0, project_root)

# Now we can safely import and run tw-report
if __name__ == "__main__":
    # Read and execute the main script
    tw_report_path = os.path.join(project_root, "tw-report.py")
    with open(tw_report_path) as f:
        code = compile(f.read(), tw_report_path, "exec")
        # Create a namespace with __file__ and __name__ set correctly
        namespace = {
            "__file__": tw_report_path,
            "__name__": "__main__",
            "__package__": None,
        }
        exec(code, namespace)
